# Copy to `.env.local` for local development or set in Vercel Dashboard for production.
# NEVER commit `.env` or `.env.local` with real secrets to GitHub!

# PostgreSQL database URL used by Prisma (e.g. Neon.tech free PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Live Django REST Backend URL (Render / Railway URL in production, no trailing slash)
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:8000"

# Google Generative AI API Key for Gemini
GOOGLE_GENERATIVE_AI_API_KEY="your_google_generative_ai_api_key"
